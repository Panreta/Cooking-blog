---
import Base from '../layouts/Base.astro';
---

<Base title="Recipe">
  <article id="post">
    <p class="status container">Loading…</p>
  </article>
</Base>

<script>
  import { supabase, getUser, type Post } from '../lib/supabase';
  import { url, esc, formatDate, paragraphs } from '../lib/util';

  const root = document.getElementById('post')!;
  const id = new URLSearchParams(location.search).get('id');

  function render(p: Post, isOwner: boolean) {
    document.title = `${p.title} · Cooking Bible`;
    const facts = [
      ['Prep', p.prep_time],
      ['Cook', p.cook_time],
      ['Serves', p.servings],
    ].filter(([, v]) => v);

    const recipeCard =
      facts.length || p.ingredients.length
        ? `<aside class="recipe-card">
            ${facts.length ? `<dl class="facts">${facts.map(([k, v]) => `<div><dt>${k}</dt><dd>${esc(v)}</dd></div>`).join('')}</dl>` : ''}
            ${
              p.ingredients.length
                ? `<h2>Ingredients</h2>
                   <ul class="ingredients">${p.ingredients.map((i) => `<li><label><input type="checkbox"><span>${esc(i)}</span></label></li>`).join('')}</ul>`
                : ''
            }
          </aside>`
        : '';

    const steps = p.steps.filter((s) => s.text || s.photo);

    root.innerHTML = `
      <header class="container post-head">
        <div class="tags">${p.tags.map((t) => `<a class="tag" href="${url(`?tag=${encodeURIComponent(t)}`)}">${esc(t)}</a>`).join('')}</div>
        <h1>${esc(p.title)}</h1>
        ${p.description ? `<p class="lede">${esc(p.description)}</p>` : ''}
        <span class="eyebrow">By ${esc(p.author_name)} · ${formatDate(p.created_at)}</span>
        ${
          isOwner
            ? `<div class="owner-actions">
                <a class="btn btn-ghost" href="${url(`new/?id=${p.id}`)}">Edit</a>
                <button class="btn btn-danger" id="delete">Delete</button>
              </div>`
            : ''
        }
      </header>
      <div class="container"><div class="cover"><img src="${esc(p.cover_url)}" alt="${esc(p.title)}"></div></div>
      <div class="container layout">
        ${recipeCard}
        <div class="prose" ${recipeCard ? '' : 'style="grid-column:1/-1;margin:0 auto"'}>
          ${paragraphs(p.story)}
          ${
            steps.length
              ? `<h2>Steps</h2>
                 <ol class="steps">${steps
                   .map((s) => `<li>${paragraphs(s.text)}${s.photo ? `<img src="${esc(s.photo)}" alt="" loading="lazy">` : ''}</li>`)
                   .join('')}</ol>`
              : ''
          }
          ${p.tips ? `<div class="tip"><strong>Tip</strong>${paragraphs(p.tips)}</div>` : ''}
        </div>
      </div>`;

    document.getElementById('delete')?.addEventListener('click', async () => {
      if (!confirm('Delete this post? This cannot be undone.')) return;
      const { error } = await supabase.from('posts').delete().eq('id', p.id);
      if (error) return alert(error.message);
      location.href = url();
    });
  }

  async function load() {
    if (!id) {
      root.innerHTML = `<p class="status container">Recipe not found. <a href="${url()}">Back to all recipes</a></p>`;
      return;
    }
    const [{ data, error }, user] = await Promise.all([supabase.from('posts').select('*').eq('id', id).maybeSingle(), getUser()]);
    if (error || !data) {
      root.innerHTML = `<p class="status container">Recipe not found. <a href="${url()}">Back to all recipes</a></p>`;
      return;
    }
    render(data as Post, user?.id === data.author_id);
  }

  load();
</script>
