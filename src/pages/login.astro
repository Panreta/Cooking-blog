---
import Base from '../layouts/Base.astro';
---

<Base title="Log in">
  <section class="container form-page" style="max-width:440px">
    <h1 id="heading">Welcome back</h1>
    <p class="sub">Log in to share your recipes.</p>

    <div class="tabs" role="tablist">
      <button type="button" role="tab" aria-selected="true" data-mode="signin">Log in</button>
      <button type="button" role="tab" aria-selected="false" data-mode="signup">Sign up</button>
    </div>

    <form id="auth-form" class="panel">
      <label class="field" id="name-field" hidden>
        <span>Your name</span>
        <input type="text" name="name" autocomplete="nickname" placeholder="Shown on your posts" />
      </label>
      <label class="field">
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label class="field">
        <span>Password</span>
        <input type="password" name="password" autocomplete="current-password" minlength="6" required />
      </label>
      <div class="form-actions" style="margin-top:20px">
        <button class="btn" type="submit" id="submit" style="width:100%">Log in</button>
      </div>
    </form>
    <p id="message" class="notice" hidden></p>
  </section>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { url } from '../lib/util';

  const form = document.getElementById('auth-form') as HTMLFormElement;
  const nameField = document.getElementById('name-field')!;
  const submit = document.getElementById('submit') as HTMLButtonElement;
  const message = document.getElementById('message')!;
  const heading = document.getElementById('heading')!;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  let mode: 'signin' | 'signup' = 'signin';

  function show(text: string, isError = false) {
    message.textContent = text;
    message.classList.toggle('error', isError);
    message.hidden = false;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((tab) => {
    tab.addEventListener('click', () => {
      mode = tab.dataset.mode as typeof mode;
      document.querySelectorAll('[data-mode]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      nameField.hidden = mode === 'signin';
      submit.textContent = mode === 'signin' ? 'Log in' : 'Create account';
      heading.textContent = mode === 'signin' ? 'Welcome back' : 'Join the kitchen';
      field('password').autocomplete = mode === 'signin' ? 'current-password' : 'new-password';
      message.hidden = true;
    });
  });

  // Already logged in? Go straight to the feed.
  supabase.auth.getSession().then(({ data }) => {
    if (data.session) location.replace(url());
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = field('email').value.trim();
    const password = field('password').value;
    submit.disabled = true;
    message.hidden = true;

    if (mode === 'signin') {
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      submit.disabled = false;
      if (error) return show(error.message, true);
      location.href = url();
    } else {
      const { data, error } = await supabase.auth.signUp({
        email,
        password,
        options: {
          data: { display_name: field('name').value.trim() || email.split('@')[0] },
          emailRedirectTo: location.origin + url('login/'),
        },
      });
      submit.disabled = false;
      if (error) return show(error.message, true);
      if (data.session) location.href = url();
      else show('Check your email for a confirmation link, then come back and log in.');
    }
  });
</script>
